{%- liquid
  assign ss = section.settings
  assign pt_mobile = ss.padding_top_mobile | default: 40
  assign pb_mobile = ss.padding_bottom_mobile | default: 40
  assign pt_desktop = ss.padding_top_desktop | default: 60
  assign pb_desktop = ss.padding_bottom_desktop | default: 60
  assign bg_color = ss.background_color | default: '#f5f5f9'
-%}

{%- capture container_padding -%}
  style="
    {% render 'rt-section-padding',
      section_pt_mobile: pt_mobile,
      section_pb_mobile: pb_mobile,
      section_pt_desktop: pt_desktop,
      section_pb_desktop: pb_desktop
    %}
  "
{%- endcapture -%}

{% style %}
  #shopify-section-{{ section.id }} .rt-main-products-box {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    row-gap: 40px;
  }

  #shopify-section-{{ section.id }} .rt-main-products-box > .rt-main-products-full-block {
    grid-column: 1 / -1;
    position: relative;
  }
{% endstyle %}

<div
  id="{{ section.id }}"
  class="rt-section"
  style="--rt-section-bg-color: {{ bg_color }};"
>
  <div class="rt-ss-padding" {{ container_padding }}>
    <div class="rt-container ">
      {% comment %} <div class="rt-heading-box">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'title' -%}
              {% render 'rt-heading',
                variant: 'title',
                text: block.settings.text,
                color: block.settings.text_color,
                shopify_attributes: block.shopify_attributes
              %}

            {%- when 'description' -%}
              {% render 'rt-heading',
                variant: 'description',
                text: block.settings.text,
                color: block.settings.text_color,
                shopify_attributes: block.shopify_attributes
              %}
          {%- endcase -%}
        {%- endfor -%}
      </div> {% endcomment %}

      <div class="rt-main-products-box">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'half-block' -%}
              {% render 'rt-main-products-half-block', block: block %}
            {%- when 'full-block' -%}
              {% render 'rt-main-products-full-block', block: block %}
          {%- endcase -%}
        {%- endfor -%}
      </div>

    </div>
  </div>
</div>

