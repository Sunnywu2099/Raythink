{%- liquid
  assign ss = section.settings
  assign pt_mobile = ss.padding_top_mobile | default: 40
  assign pb_mobile = ss.padding_bottom_mobile | default: 40
  assign pt_desktop = ss.padding_top_desktop | default: 60
  assign pb_desktop = ss.padding_bottom_desktop | default: 60
  assign bg_color = ss.background_color | default: '#f5f5f9'
  assign vertical_on_mobile = ss.vertical_on_mobile | default: false, allow_false: true
  assign enable_min_width = ''
  if vertical_on_mobile
    assign enable_min_width = 750
  endif
  assign show_heading = false
  for block in section.blocks
    if block.type == 'title' or block.type == 'description'
      if block.settings.text != blank
        assign show_heading = true
        break
      endif
    endif
  endfor
-%}

{%- capture container_padding -%}
  style="
    {% render 'rt-section-padding',
      section_pt_mobile: pt_mobile,
      section_pb_mobile: pb_mobile,
      section_pt_desktop: pt_desktop,
      section_pb_desktop: pb_desktop
    %}
  "
{%- endcapture -%}

{% style %}
  .rt-blogs-swiper .rt-swiper .swiper{
    overflow: visible;
  }
  #shopify-section-{{ section.id }} .rt-blogs-swiper-link{
    display: flex;
    align-items: center;
    gap: 8px;
    justify-content: flex-end;
  }
  #shopify-section-{{ section.id }} .rt-blogs-swiper-link-text{
    font-size: 14px;
    line-height: 18px;
    font-weight: 400;
    color: rgb(0 0 0 / 65%);
    text-decoration: underline;
  }
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .rt-blogs-swiper-link-text{
      font-size: 16px;
      line-height: 20px;
    }
  }
{% endstyle %}

<div
  id="{{ section.id }}"
  class="rt-section"
  style="--rt-section-bg-color: {{ bg_color }};"
>
  <div class="rt-ss-padding" {{ container_padding }}>
    <div class="rt-container ">
      {%- if show_heading -%}
        <div class="rt-heading-box">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'title' -%}
                {% render 'rt-heading',
                  variant: 'title',
                  text: block.settings.text,
                  color: block.settings.text_color,
                  shopify_attributes: block.shopify_attributes
                %}

              {%- when 'description' -%}
                {% render 'rt-heading',
                  variant: 'subtitle',
                  text: block.settings.text,
                  color: block.settings.text_color,
                  shopify_attributes: block.shopify_attributes
                %}
              
              {%- when 'link' -%}
                <div class="rt-blogs-swiper-link">
                  <a href="{{ block.settings.url }}" class="rt-blogs-swiper-link-text" target="_blank" rel="noopener noreferrer">{{ block.settings.text }}</a>
                  <span class="rt-blogs-swiper-link-icon">{% render 'rt-icon', icon: 'arrow-right' %}</span>
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="rt-sharing">
        {%- capture rt_blogs_slides -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'blog-block' -%}
              <div class="swiper-slide">
                {% render 'rt-blog-block', block: block %}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}

        {%- if rt_blogs_slides != blank -%}
          {% render 'rt-swiper',
            slides: rt_blogs_slides,
            class: 'rt-sharing-swiper',
            slides_per_view: '1',
            space_between: 8,
            pagination: true,
            navigation: true,
            breakpoints: '{"750":{"slidesPerView":1.3,"spaceBetween":20},"1024":{"slidesPerView":3,"spaceBetween":20}}',
            enable_min_width: enable_min_width
          %}
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

{% schema %}
  {
    "name": "rt-blogs-swiper",
    "tag": "section",
    "disabled_on": {
      "groups": ["header", "footer"]
    },
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "label": "Section背景颜色",
        "default": "#f5f5f9"
      },
      {
        "type": "checkbox",
        "id": "vertical_on_mobile",
        "label": "移动端使用垂直排列",
        "default": false
      },
      {
        "type": "header",
        "content": "间距"
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "上（移动端）",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "下（移动端）",
        "default": 96
      },
      {
        "type": "range",
        "id": "padding_top_desktop",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "label": "上（桌面端）",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_bottom_desktop",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "label": "下（桌面端）",
        "default": 160
      }
    ],
    "blocks": [
      {
        "type": "title",
        "name": "标题",
        "settings": [
          {
            "type": "color",
            "id": "text_color",
            "label": "文字颜色",
            "default": "#000000"
          },
          {
            "type": "text",
            "id": "text",
            "label": "标题",
            "default": "Featured Blogs and News"
          }
        ]
      },
      {
        "type": "description",
        "name": "描述",
        "settings": [
          {
            "type": "color",
            "id": "text_color",
            "label": "文字颜色",
            "default": "#595959"
          },
          {
            "type": "text",
            "id": "text",
            "label": "内容",
            "default": "Every Raythink thermal system is calibrated against blackbody standards to guarantee accurate, actionable thermal data in mission-critical environments."
          }
        ]
      },
      {
        "type": "link",
        "name": "链接",
        "settings": [
          {
            "type": "url",
            "id": "url",
            "label": "链接"
          },
          {
            "type": "text",
            "id": "text",
            "label": "链接文本",
            "default": "View All >"
          }
        ]
      },
      {
        "type": "blog-block",
        "name": "blog-block",
        "settings": [
          {
            "type": "color",
            "id": "bg_color",
            "label": "卡片背景颜色",
            "default": "#ffffff"
          },
          {
            "type": "image_picker",
            "id": "img",
            "label": "图片"
          },
          {
            "type": "text",
            "id": "title",
            "label": "标题",
            "default": "Stay Safe During Rolling Blackouts With Reliable Backup Power"
          },
          {
            "type": "color",
            "id": "title_color",
            "label": "标题颜色",
            "default": "#000000"
          },
          {
            "type": "text",
            "id": "text",
            "label": "内容",
            "default": "Vestibulum ante ipsum primis in faucibus orci luctus et ultrices posuere cubilia curae; Praesent libero ipsum, malesuada quis est sed, venenatis dignissim leo. Morbi ac arcu orci. Ut quis enim purus"
          },
          {
            "type": "color",
            "id": "text_color",
            "label": "内容颜色",
            "default": "#595959"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "rt-blogs-swiper",
        "category": "rt-homepage"
      }
    ]
  }
  {% endschema %}