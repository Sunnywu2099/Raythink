{% comment %}
  Raythink TI Studio PC Client | Shopify OS 2.0 section
  Install: Online Store > Themes > Edit code > Sections > Add new section
  File: raythink-ti-studio.liquid
{% endcomment %}
{% liquid
  assign rt_download = section.settings.download_url
  assign rt_manual = section.settings.manual_url
%}
<section id="rt-ti-{{ section.id }}" class="rt-ti" style="--rt-accent:{{ section.settings.accent_color }};--rt-dark:#111b25;">
  <div class="rt-ti__hero">
    <div class="rt-ti__wrap rt-ti__hero-grid">
      <div class="rt-ti__hero-copy">
        <p class="rt-ti__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h1>{{ section.settings.heading | escape }}</h1>
        <h2>{{ section.settings.hero_subheading | escape }}</h2>
        <p class="rt-ti__lede">{{ section.settings.hero_description | escape }}</p>
        <div class="rt-ti__hero-actions">
          {% if rt_download != blank %}<a class="rt-ti__btn rt-ti__btn--accent" href="{{ rt_download | escape }}" aria-label="Download TI Studio for Windows">{% render 'icon-download', fallback: 'download' %}<span>{{ section.settings.download_label | escape }}</span></a>{% endif %}
          {% if rt_manual != blank %}<a class="rt-ti__btn rt-ti__btn--outline-light" href="{{ rt_manual | escape }}" target="_blank" rel="noopener noreferrer">{{ section.settings.manual_label | escape }} ↗</a>{% endif %}
        </div>
        <div class="rt-ti__platform">{{ section.settings.platform_note | escape }}</div>
      </div>
      <div class="rt-ti__hero-visual">
        {% if section.settings.hero_image != blank %}
          {{ section.settings.hero_image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '420,720,980,1400', sizes: '(min-width: 900px) 48vw, 100vw', alt: 'TI Studio thermal imaging software interface' }}
        {% elsif section.settings.hero_image_url != blank %}
          <img src="{{ section.settings.hero_image_url | escape }}" loading="eager" alt="TI Studio thermal imaging software interface">
        {% else %}
          <div class="rt-ti__hero-placeholder">TI Studio <small>Professional Thermal Analysis Software</small></div>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="rt-ti__wrap">
    <div class="rt-ti__intro rt-ti__section">
      <p class="rt-ti__eyebrow rt-ti__eyebrow--accent">WHY TI STUDIO</p>
      <h2>{{ section.settings.intro_heading | escape }}</h2>
      <p>{{ section.settings.intro_text | escape }}</p>
      <nav class="rt-ti__jump" aria-label="Software sections"><a href="#rt-ti-features-{{ section.id }}">Explore features ↓</a><a href="#rt-ti-download-{{ section.id }}">Go to downloads ↓</a></nav>
    </div>

    <div id="rt-ti-features-{{ section.id }}" class="rt-ti__section">
      <div class="rt-ti__section-head"><p class="rt-ti__eyebrow rt-ti__eyebrow--accent">SOFTWARE CAPABILITIES</p><h2>Built for Advanced Thermal Workflows</h2><p>From real-time inspection to reporting, TI Studio brings professional tools into one workspace.</p></div>
      <div class="rt-ti__feature-list">
        {% for block in section.blocks %}
          {% if block.type == 'feature_large' %}
            <article class="rt-ti__feature rt-ti__feature--{% cycle 'standard', 'reverse' %}" {{ block.shopify_attributes }}>
              <div class="rt-ti__feature-media">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400,700,1000,1400', sizes: '(min-width: 900px) 50vw, 100vw', alt: block.settings.title }}
                {% elsif block.settings.image_url != blank %}
                  <img src="{{ block.settings.image_url | escape }}" loading="lazy" alt="{{ block.settings.title | escape }}">
                {% else %}<div class="rt-ti__media-placeholder">{{ block.settings.title | escape }}</div>{% endif %}
              </div>
              <div class="rt-ti__feature-copy"><p class="rt-ti__number">0{{ forloop.index }}</p><h3>{{ block.settings.title | escape }}</h3><div class="rt-ti__richtext">{{ block.settings.description }}</div></div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="rt-ti__section rt-ti__pro">
      <div class="rt-ti__section-head"><p class="rt-ti__eyebrow rt-ti__eyebrow--accent">MORE PROFESSIONAL CAPABILITIES</p><h2>Monitor, Record & Collaborate</h2><p>Extended capabilities for demanding inspection and monitoring workflows.</p></div>
      <div class="rt-ti__cards">
        {% for block in section.blocks %}
          {% if block.type == 'feature_card' %}
            <article class="rt-ti__card" {{ block.shopify_attributes }}>
              <div class="rt-ti__card-media">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,600,900', sizes: '(min-width: 900px) 48vw, 100vw', alt: block.settings.title }}
                {% elsif block.settings.image_url != blank %}
                  <img src="{{ block.settings.image_url | escape }}" loading="lazy" alt="{{ block.settings.title | escape }}">
                {% else %}<div class="rt-ti__media-placeholder">{{ block.settings.title | escape }}</div>{% endif %}
              </div>
              <div class="rt-ti__card-copy"><h3>{{ block.settings.title | escape }}</h3><div class="rt-ti__richtext">{{ block.settings.description }}</div></div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <div id="rt-ti-download-{{ section.id }}" class="rt-ti__download-area">
    <div class="rt-ti__wrap rt-ti__section">
      <div class="rt-ti__section-head"><p class="rt-ti__eyebrow rt-ti__eyebrow--accent">GET STARTED</p><h2>Download TI Studio</h2><p>Get the PC client and the user manual to start your thermal analysis workflow.</p></div>
      <div class="rt-ti__download-grid">
        <div class="rt-ti__download-card rt-ti__download-card--main">
          <div class="rt-ti__download-icon" aria-hidden="true">▣</div><h3>TI Studio PC Client</h3>
          <p>{{ section.settings.pc_description | escape }}</p>
          <div class="rt-ti__metadata"><span>{{ section.settings.platform_note | escape }}</span><span>{{ section.settings.version_note | escape }}</span></div>
          {% if rt_download != blank %}<a class="rt-ti__btn rt-ti__btn--accent" href="{{ rt_download | escape }}">↓ {{ section.settings.download_label | escape }}</a>{% endif %}
          {% if rt_manual != blank %}<a class="rt-ti__text-link" href="{{ rt_manual | escape }}" target="_blank" rel="noopener noreferrer">{{ section.settings.manual_label | escape }} ↗</a>{% endif %}
        </div>
        <div class="rt-ti__download-card"><div class="rt-ti__download-icon" aria-hidden="true">▤</div><h3>TI Studio Mobile Client</h3><p>Explore on-site inspection and thermal image analysis on supported mobile devices.</p>
          {% if section.settings.mobile_url != blank %}<a class="rt-ti__btn rt-ti__btn--dark" href="{{ section.settings.mobile_url | escape }}" target="_blank" rel="noopener noreferrer">Explore Mobile Client ↗</a>{% endif %}
          <p class="rt-ti__fineprint">App availability and supported device functions may vary.</p>
        </div>
      </div>
      <p class="rt-ti__disclaimer">{{ section.settings.compatibility_note | escape }}</p>
    </div>
  </div>
</section>
<style>
#rt-ti-{{ section.id }}{font-family:inherit;color:#20262d;background:#fff;line-height:1.6}#rt-ti-{{ section.id }} *{box-sizing:border-box}#rt-ti-{{ section.id }} .rt-ti__wrap{width:min(1200px,calc(100% - 44px));margin:auto}#rt-ti-{{ section.id }} .rt-ti__hero{background:linear-gradient(120deg,#111b25 0%,#20313e 100%);color:#fff;padding:72px 0}#rt-ti-{{ section.id }} .rt-ti__hero-grid{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:60px}#rt-ti-{{ section.id }} .rt-ti__eyebrow{font-size:12px;letter-spacing:.15em;font-weight:700;margin:0 0 18px;color:#b9c5cc}#rt-ti-{{ section.id }} .rt-ti__eyebrow--accent{color:var(--rt-accent)}#rt-ti-{{ section.id }} .rt-ti__hero h1{font-size:clamp(48px,5vw,78px);line-height:1.03;color:white;margin:0 0 16px;font-weight:750}#rt-ti-{{ section.id }} .rt-ti__hero h2{font-size:clamp(25px,3vw,40px);color:white;line-height:1.15;margin:0 0 22px;font-weight:600}#rt-ti-{{ section.id }} .rt-ti__lede{font-size:16px;line-height:1.85;color:#d4dee4;max-width:580px;margin:0 0 28px}#rt-ti-{{ section.id }} .rt-ti__hero-actions{display:flex;flex-wrap:wrap;gap:12px}#rt-ti-{{ section.id }} .rt-ti__btn{display:inline-flex;align-items:center;justify-content:center;text-decoration:none;border-radius:6px;padding:14px 23px;min-height:48px;font-size:14px;font-weight:700;line-height:1.3;transition:transform .2s,opacity .2s}#rt-ti-{{ section.id }} .rt-ti__btn:hover{transform:translateY(-2px);opacity:.9}#rt-ti-{{ section.id }} .rt-ti__btn--accent{background:var(--rt-accent);color:white;border:1px solid var(--rt-accent)}#rt-ti-{{ section.id }} .rt-ti__btn--outline-light{border:1px solid #8a98a4;color:white;background:transparent}#rt-ti-{{ section.id }} .rt-ti__btn--dark{background:#1c2933;color:#fff}#rt-ti-{{ section.id }} .rt-ti__platform{font-size:13px;color:#b5c2cc;margin-top:17px}#rt-ti-{{ section.id }} .rt-ti__hero-visual img{display:block;width:100%;height:auto;border-radius:12px;box-shadow:0 24px 55px #0006}#rt-ti-{{ section.id }} .rt-ti__hero-placeholder{min-height:340px;display:flex;flex-direction:column;align-items:center;justify-content:center;border:1px solid #597184;background:linear-gradient(135deg,#263e50,#09121b);border-radius:12px;font-size:50px;font-weight:700}#rt-ti-{{ section.id }} .rt-ti__hero-placeholder small{font-size:14px;font-weight:400}#rt-ti-{{ section.id }} .rt-ti__section{padding:80px 0}#rt-ti-{{ section.id }} .rt-ti__intro{text-align:center;max-width:800px;margin:auto}#rt-ti-{{ section.id }} .rt-ti__intro h2,#rt-ti-{{ section.id }} .rt-ti__section-head h2{font-size:clamp(27px,3vw,42px);line-height:1.2;margin:0 0 18px;color:#1b2329}#rt-ti-{{ section.id }} .rt-ti__intro>p:not(.rt-ti__eyebrow),#rt-ti-{{ section.id }} .rt-ti__section-head>p:not(.rt-ti__eyebrow){color:#64707a;font-size:16px;line-height:1.8}#rt-ti-{{ section.id }} .rt-ti__jump{display:flex;justify-content:center;gap:25px;margin-top:25px;flex-wrap:wrap}#rt-ti-{{ section.id }} .rt-ti__jump a,#rt-ti-{{ section.id }} .rt-ti__text-link{color:var(--rt-accent);font-weight:650;text-decoration:none;font-size:14px}#rt-ti-{{ section.id }} .rt-ti__section-head{text-align:center;max-width:800px;margin:0 auto 45px}#rt-ti-{{ section.id }} .rt-ti__feature-list{display:grid;gap:45px}#rt-ti-{{ section.id }} .rt-ti__feature{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}#rt-ti-{{ section.id }} .rt-ti__feature--reverse .rt-ti__feature-media{order:2}#rt-ti-{{ section.id }} .rt-ti__feature-media img{width:100%;height:auto;display:block;border-radius:9px}#rt-ti-{{ section.id }} .rt-ti__feature-media{background:#f3f6f8;border-radius:9px;overflow:hidden;min-height:230px;display:flex;align-items:center}#rt-ti-{{ section.id }} .rt-ti__media-placeholder{height:260px;width:100%;display:flex;align-items:center;justify-content:center;color:#6c7b86;text-align:center;padding:20px}#rt-ti-{{ section.id }} .rt-ti__number{color:var(--rt-accent);font-size:13px;font-weight:700;letter-spacing:.14em}#rt-ti-{{ section.id }} .rt-ti__feature h3{font-size:clamp(23px,2.5vw,32px);line-height:1.25;margin:12px 0 16px;color:#19242c}#rt-ti-{{ section.id }} .rt-ti__richtext{font-size:15px;line-height:1.85;color:#56636c}#rt-ti-{{ section.id }} .rt-ti__richtext p{margin:0 0 12px}#rt-ti-{{ section.id }} .rt-ti__richtext ul{padding-left:19px;margin:10px 0 0}#rt-ti-{{ section.id }} .rt-ti__richtext li{margin:6px 0}#rt-ti-{{ section.id }} .rt-ti__pro{border-top:1px solid #e8edf1}#rt-ti-{{ section.id }} .rt-ti__cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:25px}#rt-ti-{{ section.id }} .rt-ti__card{background:#f7f9fa;border:1px solid #edf0f2;border-radius:10px;overflow:hidden}#rt-ti-{{ section.id }} .rt-ti__card-media{background:#edf2f4}#rt-ti-{{ section.id }} .rt-ti__card-media img{width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;display:block}#rt-ti-{{ section.id }} .rt-ti__card-copy{padding:28px}#rt-ti-{{ section.id }} .rt-ti__card h3{font-size:22px;line-height:1.3;color:#1b252e;margin:0 0 12px}#rt-ti-{{ section.id }} .rt-ti__download-area{background:#f3f6f8}#rt-ti-{{ section.id }} .rt-ti__download-grid{display:grid;grid-template-columns:1fr 1fr;gap:23px}#rt-ti-{{ section.id }} .rt-ti__download-card{background:#fff;border:1px solid #e4ebef;border-radius:10px;padding:35px;display:flex;flex-direction:column;align-items:flex-start}#rt-ti-{{ section.id }} .rt-ti__download-icon{font-size:32px;color:var(--rt-accent)}#rt-ti-{{ section.id }} .rt-ti__download-card h3{font-size:24px;margin:12px 0}#rt-ti-{{ section.id }} .rt-ti__download-card>p{color:#65727b;margin:0 0 16px;font-size:15px}#rt-ti-{{ section.id }} .rt-ti__download-card .rt-ti__btn{margin:12px 0}#rt-ti-{{ section.id }} .rt-ti__metadata{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 13px}#rt-ti-{{ section.id }} .rt-ti__metadata span{background:#f0f3f5;border-radius:4px;color:#5c6871;padding:5px 9px;font-size:12px}#rt-ti-{{ section.id }} .rt-ti__fineprint,#rt-ti-{{ section.id }} .rt-ti__disclaimer{font-size:12px!important;color:#79858c!important}#rt-ti-{{ section.id }} .rt-ti__disclaimer{text-align:center;margin:24px 0 0}
@media(max-width:900px){#rt-ti-{{ section.id }} .rt-ti__hero-grid,#rt-ti-{{ section.id }} .rt-ti__feature{grid-template-columns:1fr;gap:25px}#rt-ti-{{ section.id }} .rt-ti__feature--reverse .rt-ti__feature-media{order:0}#rt-ti-{{ section.id }} .rt-ti__hero{padding:50px 0}#rt-ti-{{ section.id }} .rt-ti__feature-list{gap:65px}}@media(max-width:650px){#rt-ti-{{ section.id }} .rt-ti__wrap{width:calc(100% - 32px)}#rt-ti-{{ section.id }} .rt-ti__section{padding:52px 0}#rt-ti-{{ section.id }} .rt-ti__cards,#rt-ti-{{ section.id }} .rt-ti__download-grid{grid-template-columns:1fr}#rt-ti-{{ section.id }} .rt-ti__card-copy,#rt-ti-{{ section.id }} .rt-ti__download-card{padding:23px}#rt-ti-{{ section.id }} .rt-ti__hero-actions{flex-direction:column;align-items:stretch}#rt-ti-{{ section.id }} .rt-ti__hero-placeholder{min-height:220px}#rt-ti-{{ section.id }} .rt-ti__feature-media{min-height:0}}
</style>
{% schema %}
{
  "name": "TI Studio software",
  "tag": "section",
  "class": "section-ti-studio",
  "settings": [
    {"type":"color","id":"accent_color","label":"Accent color","default":"#dd613a"},
    {"type":"text","id":"eyebrow","label":"Hero eyebrow","default":"RAYTHINK SOFTWARE"},
    {"type":"text","id":"heading","label":"Hero title","default":"TI Studio"},
    {"type":"text","id":"hero_subheading","label":"Hero subtitle","default":"Analyze. Monitor. Report."},
    {"type":"textarea","id":"hero_description","label":"Hero description","default":"Professional thermal analysis software for temperature measurement, device management, real-time monitoring, and inspection reporting."},
    {"type":"image_picker","id":"hero_image","label":"Hero image (recommended: upload a software screenshot)"},
    {"type":"url","id":"hero_image_url","label":"Fallback hero image URL"},
    {"type":"text","id":"download_label","label":"Download button label","default":"Download for Windows"},
    {"type":"url","id":"download_url","label":"PC installer URL"},
    {"type":"text","id":"manual_label","label":"Manual button label","default":"Download User Manual"},
    {"type":"url","id":"manual_url","label":"User manual URL"},
    {"type":"text","id":"platform_note","label":"Operating system note","default":"Windows 10 / 11 · 64-bit"},
    {"type":"text","id":"version_note","label":"Version note","default":"V2.0.2 (004) — verify latest release"},
    {"type":"text","id":"intro_heading","label":"Intro heading","default":"One Platform. Complete Thermal Insight."},
    {"type":"textarea","id":"intro_text","label":"Intro description","default":"TI Studio PC Client brings together live thermal monitoring, radiometric analysis, customizable measurement tools, intelligent alarms, professional reporting, and device management for demanding inspection workflows."},
    {"type":"textarea","id":"pc_description","label":"PC download card description","default":"Perform real-time and offline thermal analysis, track temperature trends, manage alarms, and create professional reports."},
    {"type":"url","id":"mobile_url","label":"Mobile client page URL"},
    {"type":"textarea","id":"compatibility_note","label":"Compatibility disclaimer","default":"Features and supported workflows may vary by Raythink device, firmware, connection method, and software version. Please check device compatibility before installation."}
  ],
  "blocks": [
    {"type":"feature_large","name":"Large feature","limit":4,"settings":[{"type":"text","id":"title","label":"Feature title"},{"type":"richtext","id":"description","label":"Description"},{"type":"image_picker","id":"image","label":"Feature image (upload)"},{"type":"url","id":"image_url","label":"Fallback external image URL"}]},
    {"type":"feature_card","name":"Professional feature","limit":4,"settings":[{"type":"text","id":"title","label":"Feature title"},{"type":"richtext","id":"description","label":"Description"},{"type":"image_picker","id":"image","label":"Feature image (upload)"},{"type":"url","id":"image_url","label":"Fallback external image URL"}]}
  ],
  "presets": [{
    "name":"TI Studio software",
    "settings":{
      "hero_image_url":"https://www.raythink-tech.com/wp-content/uploads/2026/05/图片1.jpg",
      "download_url":"https://www.raythink-tech.com/apk/TI_Studio_OS_V2.0.2(004).ABROAD_WIN64_WIN1011.exe",
      "manual_url":"https://www.raythink-tech.com/wp-content/uploads/2026/04/TI-Studio-User-Manual_-V1.1.7.pdf",
      "mobile_url":"https://www.raythink-tech.com/ti-studio-mobile-client/"
    },
    "blocks":[
      {"type":"feature_large","settings":{"title":"Broad Product Compatibility","description":"<p>Manage compatible fixed and handheld thermal cameras and infrared modules in one place. Automatically detect devices, manage device information, and access real-time previews for efficient inspection workflows.</p><p>Device support includes RT630 remote access and TN330 compatibility.</p>","image_url":"https://www.raythink-tech.com/wp-content/uploads/2026/05/图片1.jpg"}},
      {"type":"feature_large","settings":{"title":"Powerful Analysis Capability","description":"<p>Perform live temperature measurement and analysis, then revisit thermal images and recordings for in-depth offline analysis. Supports continuous playback, extended full-frame-rate recording, and Delta T measurements in offline analysis and reporting.</p>","image_url":"https://www.raythink-tech.com/wp-content/uploads/2026/05/图片2.jpg"}},
      {"type":"feature_large","settings":{"title":"Diverse Analysis Tools","description":"<p>Use point, line, circle, rectangle, polygon, area shielding, and offline polyline tools. Inspect thermal data with palettes, color highlighting, isotherms, 3D views, and level/span adjustments.</p><p>Preview and analyze up to four channels simultaneously for multi-target comparison.</p>","image_url":"https://www.raythink-tech.com/wp-content/uploads/2026/05/图片2.jpg"}},
      {"type":"feature_large","settings":{"title":"Multi-Dimensional Monitoring","description":"<p>Collect temperature data by frame, second, minute, or hour. Visualize trends, export original temperature data, and create customized professional reports using drag-and-drop templates and components.</p>","image_url":"https://www.raythink-tech.com/wp-content/uploads/2026/05/图片3.jpg"}},
      {"type":"feature_card","settings":{"title":"Multi-Layered Alarms","description":"<p>Configure temperature threshold and temperature-rise alarms for the full frame or individual measurement rules, with multiple thresholds for hierarchical monitoring.</p>","image_url":"https://www.raythink-tech.com/wp-content/uploads/2026/05/图片4.png"}},
      {"type":"feature_card","settings":{"title":"Comprehensive Logging","description":"<p>Capture alarm events through sound, snapshots, recordings, and I/O linkage. Review detailed historical events in the Alarm Center for analysis and traceability.</p>","image_url":"https://www.raythink-tech.com/wp-content/uploads/2026/05/图片5.jpg"}},
      {"type":"feature_card","settings":{"title":"Strong Device-Cloud Collaboration","description":"<p>Access images and videos synced from supported handheld devices to the cloud, download resources with a registered cloud account, and perform secondary analysis on your desktop.</p>","image_url":"https://www.raythink-tech.com/wp-content/uploads/2026/05/图片6.jpg"}},
      {"type":"feature_card","settings":{"title":"Advanced AI Capabilities","description":"<p>Get professional answers and use natural-language commands to assist with software operations and automated workflows, helping improve efficiency.</p>","image_url":"https://www.raythink-tech.com/wp-content/uploads/2026/05/图片7.png"}}
    ]
  }]
}
{% endschema %}
