{% comment %}
  Section contract.
  Product page "What's in the box". Desktop uses five columns: item 1 spans three, items 2–3 are the tall cards, and the rest fill the next row. Mobile shows item 1 full width, then three columns.
  @example
  <!-- Add rt-in-the-box below the product purchase section on product.rt-product. -->
{% endcomment %}

{%- liquid
  assign ss = section.settings
  assign pt_mobile = ss.padding_top_mobile | default: 48
  assign pb_mobile = ss.padding_bottom_mobile | default: 48
  assign pt_desktop = ss.padding_top_desktop | default: 80
  assign pb_desktop = ss.padding_bottom_desktop | default: 80
  assign bg_color = ss.background_color | default: '#ffffff'
  assign heading_color = ss.heading_color | default: '#000000'
-%}

{% stylesheet %}
  .rt-whatsin-thebox .rt-whatsin-thebox-wrapper {
    position: relative;
  }
  .rt-whatsin-thebox .rt-whatsin-thebox-content {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 10px 64px;
  }
  .rt-whatsin-thebox-content-item{
    font-size: 16px;
    line-height: 20px;
    color: rgba(255, 255, 255, 0.60);
    font-weight: 600;
  }
  

  @media (min-width: 750px) {
    
  }
{% endstylesheet %}

<div
  id="{{ section.id }}"
  class="rt-section rt-pdp rt-whatsin-thebox"
  style="--rt-section-bg-color: {{ bg_color }}; --rt-pdp-heading-color: {{ heading_color }};"
>
  <div
    class="rt-ss-padding"
    style="
      {% render 'rt-section-padding',
        section_pt_mobile: pt_mobile,
        section_pb_mobile: pb_mobile,
        section_pt_desktop: pt_desktop,
        section_pb_desktop: pb_desktop
      %}
    "
  >
    <div class="rt-container">
      <div class="rt-pdp-layout">
      <div class="rt-whatsin-thebox-wrapper rt-radius-lg overflow-hidden">
        <div class="rt-whatsin-thebox-image">
          {% render 'rt-image2picture', image_desktop: ss.image, image_mobile: ss.image_mobile, loading: 'lazy' %}
        </div>
        <div class="rt-whatsin-thebox-content">
          <div class="rt-whatsin-thebox-content-heading">
            {% render 'rt-heading', variant: 'title', text: ss.heading, color: heading_color %}
          </div>
          <div class="rt-whatsin-thebox-content-items">
            {%- for block in section.blocks -%}
                <div class="rt-whatsin-thebox-content-item">   
                  {{ forloop.index }}. {{ block.settings.title }}
                </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "rt-whatsin-thebox",
  "tag": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "What's in the box"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "标题颜色",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景颜色",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "图片（桌面端）"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "图片（移动端）"
    },
    {
      "type": "header",
      "content": "间距"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "上（移动端）",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "下（移动端）",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "上（桌面端）",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "下（桌面端）",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "物品",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "名称",
          "default": "item name"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "rt-whatsin-thebox",
      "category": "rt-product"
    }
  ]
}
{% endschema %}
