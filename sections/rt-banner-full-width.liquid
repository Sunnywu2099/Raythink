{%- liquid
  assign ss = section.settings
  assign bg_color = ss.background_color | default: '#ffffff'
  assign text_position = ss.text_position | default: 'left'
  assign text_align = ss.text_align | default: 'left'
  assign text_align_mobile = ss.text_align_mobile | default: 'left'
-%}

{% style %}
  #shopify-section-{{ section.id }} .rt-banner-full-width{
    position: relative;
  }
  #shopify-section-{{ section.id }} .rt-banner-full-width-text{
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
   #shopify-section-{{ section.id }} .rt-banner-full-width-text-content{
    max-width: 460px;
   }
  @media (min-width: 750px) {
  }
{% endstyle %}

<div
  id="{{ section.id }}"
  class="rt-section rt-banner-full-width"
  style="--rt-section-bg-color: {{ bg_color }};"
>
  <div class="rt-banner-full-width-banner">
    {% render 'rt-image2picture', image_desktop: ss.banner_desktop, image_mobile: ss.banner_mobile, loading: 'lazy' %}
  </div>

  <div class="rt-banner-full-width-text rt-container">
    <div class="rt-banner-full-width-text-content">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'title' %}
            {% render 'rt-heading', variant: 'title', text: block.settings.text, color: block.settings.text_color %}
          {% when 'description' %}
            {% render 'rt-heading', variant: 'subtitle', text: block.settings.text, color: block.settings.text_color %}
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "rt-banner-full-width",
  "tag": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "背景颜色",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "banner_desktop",
      "label": "横幅（桌面端）"
    },
    {
      "type": "image_picker",
      "id": "banner_mobile",
      "label": "横幅（移动端）"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "文案位置",
      "info": "仅支持桌面端",
      "options": [
        {
          "value": "left",
          "label": "左"
        },
        {
          "value": "right",
          "label": "右"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "文案对齐方式（桌面端）",
      "options": [
        {
          "value": "left",
          "label": "左对齐"
        },
        {
          "value": "center",
          "label": "居中对齐"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "text_align_mobile",
      "label": "文案对齐方式（移动端）",
      "options": [
        {
          "value": "left",
          "label": "左对齐"
        },
        {
          "value": "center",
          "label": "居中对齐"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "间距"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "上（移动端）",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "下（移动端）",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "上（桌面端）",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "下（桌面端）",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "title",
      "name": "标题",
      "settings": [
        {
          "type": "color",
          "id": "text_color",
          "label": "文字颜色",
          "default": "#000000"
        },
        {
          "type": "text",
          "id": "text",
          "label": "标题",
          "default": "From Inspection to Insight."
        }
      ]
    },
    {
      "type": "description",
      "name": "描述",
      "settings": [
        {
          "type": "color",
          "id": "text_color",
          "label": "文字颜色",
          "default": "#595959"
        },
        {
          "type": "text",
          "id": "text",
          "label": "内容",
          "default": "Go beyond on-site inspections with TI Studio. Capture thermal images, analyze temperature data on your PC, and create professional reports—all in one seamless workflow."
        }
      ]
    },
    {
      "type": "image",
      "name": "图片",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "图片（桌面端）"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "图片（移动端）"
        },
        {
          "type": "text",
          "id": "note",
          "label": "备注",
          "default": "*PC Software is compatible with Windows only"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "rt-banner-full-width",
      "category": "rt-product"
    }
  ]
}
{% endschema %}
