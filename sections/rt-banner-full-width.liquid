{%- liquid
  assign ss = section.settings
  assign pt_mobile = ss.padding_top_mobile | default: 0
  assign pb_mobile = ss.padding_bottom_mobile | default: 0
  assign pt_desktop = ss.padding_top_desktop | default: 0
  assign pb_desktop = ss.padding_bottom_desktop | default: 0
  assign bg_color = ss.background_color | default: '#ffffff'
-%}

{% stylesheet %}
  @media (min-width: 750px) {
  }
{% endstylesheet %}

<div
  id="{{ section.id }}"
  class="rt-section rt-banner-full-width"
  style="--rt-section-bg-color: {{ bg_color }};"
>
  <div
    class="rt-ss-padding"
    style="
      {% render 'rt-section-padding',
        section_pt_mobile: pt_mobile,
        section_pb_mobile: pb_mobile,
        section_pt_desktop: pt_desktop,
        section_pb_desktop: pb_desktop
      %}
    "
  >
    <div class="rt-banner-full-width-banner">
      {% render 'rt-image2picture', image_desktop: ss.banner_desktop, image_mobile: ss.banner_mobile, loading: 'lazy' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "rt-banner-full-width",
  "tag": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "背景颜色",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "banner_desktop",
      "label": "横幅（桌面端）"
    },
    {
      "type": "image_picker",
      "id": "banner_mobile",
      "label": "横幅（移动端）"
    },
    {
      "type": "header",
      "content": "间距"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "上（移动端）",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "下（移动端）",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "上（桌面端）",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "下（桌面端）",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "title",
      "name": "标题",
      "settings": [
        {
          "type": "color",
          "id": "text_color",
          "label": "文字颜色",
          "default": "#000000"
        },
        {
          "type": "text",
          "id": "text",
          "label": "标题",
          "default": "From Inspection to Insight."
        }
      ]
    },
    {
      "type": "description",
      "name": "描述",
      "settings": [
        {
          "type": "color",
          "id": "text_color",
          "label": "文字颜色",
          "default": "#595959"
        },
        {
          "type": "text",
          "id": "text",
          "label": "内容",
          "default": "Go beyond on-site inspections with TI Studio. Capture thermal images, analyze temperature data on your PC, and create professional reports—all in one seamless workflow."
        }
      ]
    },
    {
      "type": "image",
      "name": "图片",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "图片（桌面端）"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "图片（移动端）"
        },
        {
          "type": "text",
          "id": "note",
          "label": "备注",
          "default": "*PC Software is compatible with Windows only"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "rt-banner-full-width",
      "category": "rt-product"
    }
  ]
}
{% endschema %}
