{%- liquid
  assign ss = section.settings
  assign bg_color = ss.background_color | default: '#f5f5f9'
  assign bb_color = ss.bb_color | default: '#e5e5e5'
-%}

{% style %}
  .rt-nav-container{
    display: flex;
    gap: 32px;
    justify-content: center;
    align-items: center;
    border-bottom: 1px solid {{ bb_color }};
  }
  .rt-nav-item{
    font-size: 16px;
    line-height: 20px;
    font-weight: 600;
    padding: 12px 0;
    opacity: 0.5;
  }
  .rt-nav-item.active{
    border-bottom-color: var(--text-color, #000000);
    opacity: 1;
  }
  @media (min-width: 1024px){
    .rt-nav-item{
      font-size: 18px;
      line-height: 22px;
    }
  }
{% endstyle %}

<div
  id="{{ section.id }}"
  class="rt-section"
  style="--rt-section-bg-color: {{ bg_color }};"
>
  <div class="rt-nav-container">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'nav_block' -%}
          <div class="rt-nav-item" style="color: {{ block.settings.text_color }};border-bottom-color: {{ block.settings.text_color }};">
            <a href="#">{{ block.settings.nav_text }}</a>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
  {
    "name": "rt-nav",
    "tag": "section",
    "limit": 1,
    "disabled_on": {
      "groups": ["header", "footer"]
    },
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "label": "背景颜色",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "bb_color",
        "label": "下边框颜色",
        "default": "#e5e5e5"
      }
    ],
    "blocks": [
      {
        "type": "nav_block",
        "name": "导航块",
        "settings": [
          {
            "type": "color",
            "id": "text_color",
            "label": "文字颜色",
            "default": "#000000"
          },
          {
            "type": "text",
            "id": "nav_text",
            "label": "导航文字",
            "default": "Overview"
          },
          {
            "type": "text",
            "id": "nav_id",
            "label": "需要定位的模块ID",
            "info": "无需加#号"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "rt-nav",
        "category": "rt-navigation"
      }
    ]
  }
  {% endschema %}