{% comment %}
  Section contract.
  "Which is the Best for You?" comparison.
  Product cards sit above a shared spec table. Mobile scrolls the two together; desktop fits them in 960px.
  Spec lines use one entry per line: value|label.
  @example
  <!-- Add rt-compare on the product template with one block per product. -->
{% endcomment %}

{%- liquid
  assign ss = section.settings
  assign pt_mobile = ss.padding_top_mobile | default: 48
  assign pb_mobile = ss.padding_bottom_mobile | default: 48
  assign pt_desktop = ss.padding_top_desktop | default: 80
  assign pb_desktop = ss.padding_bottom_desktop | default: 80
  assign bg_color = ss.background_color | default: '#ffffff'
  assign compare_products = section.blocks | where: 'type', 'product'
  assign product_count = compare_products.size
  assign max_specs = 0
  for block in compare_products
    assign spec_lines = block.settings.specs | newline_to_br | replace: '<br />', '|||' | replace: '<br/>', '|||' | split: '|||'
    if spec_lines.size > max_specs
      assign max_specs = spec_lines.size
    endif
  endfor
-%}

{% stylesheet %}
  .rt-compare-layout {
    max-width: 960px;
    margin-inline: auto;
  }

  .rt-compare .rt-pdp-heading {
    text-align: start;
  }

  .rt-compare-scroll {
    overflow-x: auto;
    overscroll-behavior-x: contain;
  }

  .rt-compare-products,
  .rt-compare-spec-panel {
    width: calc(var(--rt-compare-count) * 200px + (var(--rt-compare-count) - 1) * 20px);
  }

  .rt-compare-products {
    display: flex;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rt-compare-card {
    display: flex;
    flex: 0 0 200px;
    flex-direction: column;
    align-items: center;
    width: 200px;
    min-width: 0;
    padding-bottom: 24px;
    border-radius: 4px;
    text-align: center;
  }

  .rt-compare-media {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 140px;
  }

  .rt-compare-media picture {
    width: 100%;
    height: 100%;
  }

  .rt-compare-media picture > img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .rt-compare-name,
  .rt-compare-price,
  .rt-compare-viewing,
  .rt-compare-spec-value,
  .rt-compare-spec-label {
    margin: 0;
  }

  .rt-compare-name {
    width: 100%;
    margin-top: 12px;
    color: rgb(0 0 0 / 0.88);
    font-size: 20px;
    line-height: 24px;
    font-weight: 600;
    text-align: center;
  }

  .rt-compare-price {
    width: 100%;
    margin-top: 4px;
    color: rgb(0 0 0 / 0.65);
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    text-align: center;
  }

  .rt-compare-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-top: 12px;
  }

  .rt-compare-viewing {
    color: rgb(0 0 0 / 0.88);
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    text-align: center;
  }

  .rt-compare-buy-form {
    margin: 0;
  }

  .rt-compare-buy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 28px;
    padding: 6px 16px;
    border-radius: 999px;
    background-color: rgb(0 0 0 / 0.88);
    color: rgb(255 255 255 / 0.96);
    font-size: 12px;
    line-height: 14px;
    font-weight: 400;
    text-decoration: none;
  }

  .rt-compare-buy:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .rt-compare-learn {
    color: rgb(0 0 0 / 0.88);
    font-size: 12px;
    line-height: 16px;
    font-weight: 400;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .rt-compare-spec-panel {
    margin-top: 12px;
    padding: 20px 16px;
    border-radius: 0;
    background-color: #fafafa;
  }

  .rt-compare-spec-row {
    display: grid;
    grid-template-columns: repeat(var(--rt-compare-count), minmax(0, 1fr));
    gap: 20px;
  }

  .rt-compare-spec-row + .rt-compare-spec-row {
    margin-top: 24px;
  }

  .rt-compare-spec {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .rt-compare-spec-value,
  .rt-compare-spec-label {
    max-width: 100%;
    overflow: hidden;
    white-space: nowrap;
  }

  .rt-compare-spec-value {
    color: rgb(0 0 0 / 0.88);
    font-size: 20px;
    line-height: 20px;
    font-weight: 600;
    text-align: start;
  }

  .rt-compare-spec-label {
    margin-top: 8px;
    color: rgb(0 0 0 / 0.5);
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    text-align: start;
  }

  .rt-compare-link {
    display: none;
  }

  @media (min-width: 750px) {
    .rt-compare-scroll {
      overflow: visible;
    }

    .rt-compare-products,
    .rt-compare-spec-panel {
      width: auto;
    }

    .rt-compare-products {
      display: grid;
      grid-template-columns: repeat(var(--rt-compare-count), minmax(0, 1fr));
    }

    .rt-compare-card {
      flex: none;
      width: auto;
    }

    .rt-compare-media {
      height: 206px;
    }

    .rt-compare-name {
      font-size: 24px;
      line-height: 28px;
    }

    .rt-compare-price {
      font-size: 16px;
      line-height: 20px;
    }

    .rt-compare-buy {
      min-height: 32px;
      padding: 7px 16px;
      font-size: 14px;
      line-height: 18px;
      font-weight: 600;
    }

    .rt-compare-spec-panel {
      margin-top: 40px;
      padding: 32px 64px;
    }

    .rt-compare-link {
      display: flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      margin: 40px auto 0;
      padding: 9px 20px;
      border: 1px solid rgb(0 0 0 / 0.15);
      border-radius: 999px;
      color: rgb(0 0 0 / 0.88);
      font-size: 14px;
      line-height: 18px;
      font-weight: 400;
      text-align: center;
      text-decoration: none;
    }
  }
{% endstylesheet %}

<div
  id="{{ section.id }}"
  class="rt-section rt-pdp rt-compare"
  style="--rt-section-bg-color: {{ bg_color }}; --rt-pdp-heading-color: {{ ss.heading_color }}; --rt-compare-count: {{ product_count }};"
>
  <div
    class="rt-ss-padding"
    style="
      {% render 'rt-section-padding',
        section_pt_mobile: pt_mobile,
        section_pb_mobile: pb_mobile,
        section_pt_desktop: pt_desktop,
        section_pb_desktop: pb_desktop
      %}
    "
  >
    <div class="rt-container">
      <div class="rt-compare-layout">
        {%- if ss.heading != blank -%}
          <div class="rt-pdp-heading">
            {% render 'rt-heading', variant: 'title', text: ss.heading %}
          </div>
        {%- endif -%}

        {%- if product_count > 0 -%}
          <div class="rt-compare-scroll">
            <ul class="rt-compare-products">
              {%- for block in compare_products -%}
                {% render 'rt-compare-card', block: block %}
              {%- endfor -%}
            </ul>

            {%- if max_specs > 0 -%}
              <div class="rt-compare-spec-panel">
                {%- for row in (1..max_specs) -%}
                  <div class="rt-compare-spec-row">
                    {%- for block in compare_products -%}
                      {%- liquid
                        assign spec_lines = block.settings.specs | newline_to_br | replace: '<br />', '|||' | replace: '<br/>', '|||' | split: '|||'
                        assign spec_index = row | minus: 1
                        assign clean = spec_lines[spec_index] | strip
                        assign spec_value = ''
                        assign spec_label = ''
                        if clean != blank
                          assign parts = clean | split: '|'
                          assign spec_value = parts | first | strip
                          if parts.size > 1
                            assign spec_label = parts | last | strip
                          endif
                        endif
                      -%}
                      <div class="rt-compare-spec">
                        {%- if spec_value != blank -%}
                          <p class="rt-compare-spec-value">{{ spec_value | escape }}</p>
                        {%- endif -%}
                        {%- if spec_label != blank -%}
                          <p class="rt-compare-spec-label">{{ spec_label | escape }}</p>
                        {%- endif -%}
                      </div>
                    {%- endfor -%}
                  </div>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if ss.link_text != blank -%}
          {%- if ss.link_url != blank -%}
            <a class="rt-compare-link" href="{{ ss.link_url }}">{{ ss.link_text | escape }}</a>
          {%- else -%}
            <p class="rt-compare-link">{{ ss.link_text | escape }}</p>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "rt-compare",
  "tag": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Which is the Best for You?"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "标题颜色",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "底部链接文字",
      "default": "View All Comparisons"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "底部链接"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景颜色",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "间距"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "上（移动端）",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "下（移动端）",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "上（桌面端）",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "下（桌面端）",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "产品",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "产品"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片",
          "info": "不上传时使用产品主图"
        },
        {
          "type": "text",
          "id": "title",
          "label": "名称",
          "info": "选择产品后，以产品名称为准",
          "default": "CX20"
        },
        {
          "type": "text",
          "id": "price",
          "label": "价格",
          "info": "选择产品后，以产品售价为准",
          "default": "$389.00"
        },
        {
          "type": "text",
          "id": "viewing_label",
          "label": "当前查看"
        },
        {
          "type": "text",
          "id": "buy_label",
          "label": "购买按钮"
        },
        {
          "type": "url",
          "id": "buy_url",
          "label": "购买链接"
        },
        {
          "type": "text",
          "id": "learn_label",
          "label": "了解更多"
        },
        {
          "type": "url",
          "id": "learn_url",
          "label": "了解更多链接"
        },
        {
          "type": "textarea",
          "id": "specs",
          "label": "参数",
          "info": "每行一条，格式为：数值|说明",
          "default": "6.70\"|2K+Fluid Display With LTPO\n120Hz|Ultra Smooth\n5G|Transformed\n8 Gen 2|Qualcomm® Snapdragon™\n50W|Wireless Charging"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "rt-compare",
      "category": "rt-product",
      "blocks": {
        "product_1": {
          "type": "product",
          "settings": {
            "title": "CX20",
            "price": "$389.00",
            "viewing_label": "Currently viewing",
            "learn_label": "Learn more"
          }
        },
        "product_2": {
          "type": "product",
          "settings": {
            "title": "CX20 Pro",
            "price": "$489.00",
            "buy_label": "Buy now",
            "learn_label": "Learn more"
          }
        },
        "product_3": {
          "type": "product",
          "settings": {
            "title": "CX20 Ultra",
            "price": "$589.00",
            "buy_label": "Buy now",
            "learn_label": "Learn more",
            "specs": "6.70\"|2K+Fluid Display With LTPO\n120Hz|Ultra Smooth\n5G|Transformed\n8 Gen 2|--\n50W|Wireless Charging"
          }
        }
      },
      "block_order": ["product_1", "product_2", "product_3"]
    }
  ]
}
{% endschema %}
