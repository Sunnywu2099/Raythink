{%- liquid
  assign ss = section.settings
  assign pt_mobile = ss.padding_top_mobile | default: 40
  assign pb_mobile = ss.padding_bottom_mobile | default: 40
  assign pt_desktop = ss.padding_top_desktop | default: 60
  assign pb_desktop = ss.padding_bottom_desktop | default: 60
  assign bg_color = ss.background_color | default: '#f5f5f9'
  assign show_heading = false
  for block in section.blocks
    if block.type == 'title' or block.type == 'description'
      if block.settings.text != blank
        assign show_heading = true
        break
      endif
    endif
  endfor
-%}

{%- capture container_padding -%}
  style="
    {% render 'rt-section-padding',
      section_pt_mobile: pt_mobile,
      section_pb_mobile: pb_mobile,
      section_pt_desktop: pt_desktop,
      section_pb_desktop: pb_desktop
    %}
  "
{%- endcapture -%}

{% style %}
  #shopify-section-{{ section.id }} {
    
  }

  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      
    }
  }
{% endstyle %}

<div
  id="{{ section.id }}"
  class="rt-section"
  style="--rt-section-bg-color: {{ bg_color }};"
>
  <div class="rt-ss-padding" {{ container_padding }}>
    <div class="rt-container ">
      {%- if show_heading -%}
        <div class="rt-heading-box-center">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'title' -%}
                {% render 'rt-heading',
                  variant: 'title',
                  text: block.settings.text,
                  color: block.settings.text_color,
                  shopify_attributes: block.shopify_attributes
                %}

              {%- when 'description' -%}
                {% render 'rt-heading',
                  variant: 'subtitle',
                  text: block.settings.text,
                  color: block.settings.text_color,
                  shopify_attributes: block.shopify_attributes
                %}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="rt-form-box">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'form' -%}
              {% render 'rt-form-block', block: block %}
          {%- endcase -%}
        {%- endfor -%}
      </div>

    </div>
  </div>
</div>

{% schema %}
  {
    "name": "rt-form",
    "tag": "section",
    "disabled_on": {
      "groups": ["header", "footer"]
    },
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "label": "Section背景颜色",
        "default": "#ffffff"
      },
      {
        "type": "header",
        "content": "间距"
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "上（移动端）",
        "default": 40
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "下（移动端）",
        "default": 40
      },
      {
        "type": "range",
        "id": "padding_top_desktop",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "label": "上（桌面端）",
        "default": 40
      },
      {
        "type": "range",
        "id": "padding_bottom_desktop",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "label": "下（桌面端）",
        "default": 40
      }
    ],
    "blocks": [
      {
        "type": "title",
        "name": "标题",
        "settings": [
          {
            "type": "color",
            "id": "text_color",
            "label": "文字颜色",
            "default": "#000000"
          },
          {
            "type": "text",
            "id": "text",
            "label": "标题",
            "default": "Get more information"
          }
        ]
      },
      {
        "type": "description",
        "name": "描述",
        "settings": [
          {
            "type": "color",
            "id": "text_color",
            "label": "文字颜色",
            "default": "#595959"
          },
          {
            "type": "text",
            "id": "text",
            "label": "内容",
            "default": "Subscribe for exclusive offers and Raythink updates."
          }
        ]
      },
      {
        "type": "form",
        "name": "form",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "placeholder",
            "label": "placeholder",
            "default": "Email"
          },
          {
            "type": "richtext",
            "id": "agreement",
            "label": "agreement",
            "default": "<p>I agree to the terms and privacy policy.</p>"
          },
          {
            "type": "text",
            "id": "button_text",
            "label": "button_text",
            "default": "Subscribe Now"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "rt-form",
        "category": "rt-homepage"
      }
    ]
  }
  {% endschema %}