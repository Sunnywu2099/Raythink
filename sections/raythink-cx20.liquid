{% comment %}CX20 responsive A+ story. Assign PC/MO images in theme customizer; leave empty to hide. {% endcomment %}
<style>
.cx20-story{max-width:100%;margin:0 auto;color:#fff;background:#071224;font-family:inherit}
.cx20-story *{box-sizing:border-box}
.cx20-story .cx20-image{display:block;width:100%;height:auto;vertical-align:middle}
.cx20-story .cx20-image-frame{line-height:0;overflow:hidden}
.cx20-story .cx20-wide{max-width:var(--cx20-max,1600px);margin:0 auto}
.cx20-story .cx20-slider-section{max-width:var(--cx20-max,1600px);margin:0 auto;padding:32px 0 22px}
.cx20-story .cx20-section-heading{font-size:clamp(18px,2.3vw,30px);font-weight:650;line-height:1.3;letter-spacing:.01em;text-align:center;margin:0 12px 20px}
.cx20-story .cx20-tabs{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;padding:4px 12px 16px;justify-content:safe center}
.cx20-story .cx20-tabs::-webkit-scrollbar{display:none}
.cx20-story .cx20-tab{flex:0 0 auto;border:1px solid #536b91;color:#dfeafa;background:#14263f;border-radius:4px;padding:10px 16px;font:inherit;font-size:13px;line-height:1.25;cursor:pointer}
.cx20-story .cx20-tab[aria-selected="true"]{color:#fff;background:#2565b2;border-color:#579cfa}
.cx20-story .cx20-stage{position:relative;background:#06142c;overflow:hidden}
.cx20-story .cx20-slide[hidden]{display:none!important}
.cx20-story .cx20-arrow{position:absolute;top:50%;transform:translateY(-50%);z-index:2;border:1px solid #ffffff80;background:#0a1b31b5;color:#fff;border-radius:50%;width:42px;height:42px;font-size:25px;line-height:1;display:grid;place-items:center;cursor:pointer}
.cx20-story .cx20-arrow--prev{left:12px}.cx20-story .cx20-arrow--next{right:12px}
.cx20-story .cx20-counter{text-align:center;color:#aebed6;font-size:12px;letter-spacing:.05em;padding-top:12px}
.cx20-story .cx20-placeholder{padding:70px 16px;text-align:center;color:#c7d7eb;border:1px dashed #516585;line-height:1.5}
@media(max-width:749px){.cx20-story .cx20-slider-section{padding:22px 0 10px}.cx20-story .cx20-tabs{justify-content:flex-start}.cx20-story .cx20-tab{font-size:12px;padding:9px 12px}.cx20-story .cx20-arrow{width:32px;height:32px;font-size:21px}.cx20-story .cx20-arrow--prev{left:7px}.cx20-story .cx20-arrow--next{right:7px}}
</style>
