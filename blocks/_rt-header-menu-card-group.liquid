{% doc %}
  Cards shown on the right when the menu has no categories. The left column stays empty and keeps its width.
{% enddoc %}

<div class="rt-mega__panel rt-mega__panel--loose" data-rt-mega-panel data-rt-mega-loose {{ block.shopify_attributes }}>
  <div class="rt-mega__cards">
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "卡片组",
  "tag": null,
  "settings": [],
  "blocks": [
    { "type": "_rt-header-menu-card" }
  ],
  "presets": [
    {
      "name": "卡片组",
      "blocks": [
        { "type": "_rt-header-menu-card" }
      ]
    }
  ]
}
{% endschema %}
