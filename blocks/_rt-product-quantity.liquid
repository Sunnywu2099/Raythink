{% doc %}
  Independent quantity block inside the RT details product form. Retains native
  quantity refs and the productFormButtons boundary for quantity-rule morphs.
  @example
  <!-- Add Quantity alongside RT delivery, payment, services, and purchase buttons. -->
{% enddoc %}
{% assign variant = closest.product.selected_or_first_available_variant %}


{%- if block.settings.input_style == 'custom' -%}
  {%- capture wrapper_class -%}quantity-selector-wrapper--block-{{ block.id }}{%- endcapture -%}
  {% style %}
    .{{ wrapper_class }} {
      {%- render 'input-custom-styles', block_settings: block.settings -%}
      --style-border-width-inputs: {{ block.settings.border_width }}px;
      --style-border-radius-inputs: {{ block.settings.border_radius }}px;
      --style-border-radius-buttons-primary: {{ block.settings.border_radius }}px;
      --style-border-radius-buttons-secondary: {{ block.settings.border_radius }}px;
    }
  {% endstyle %}
{%- endif -%}

<div class="rt-product-quantity" {{ block.shopify_attributes }}>
  <div class="product-form-buttons" ref="productFormButtons">
    {%- liquid
      assign has_quantity_rules = false
      if variant.quantity_rule.min > 1 or variant.quantity_rule.increment > 1 or variant.quantity_rule.max != null
        assign has_quantity_rules = true
      endif
    -%}

    <div class="rt-product-purchase__quantity">
      <h2 class="rt-product-purchase__heading quantity-label" ref="quantityLabel">
        {{ 'products.product.quantity' | t }}
        {%- if has_quantity_rules -%}
          {%- assign cart_quantity = cart | item_count_for_variant: variant.id -%}
          <span
            class="quantity-label__cart-count{% if cart_quantity == 0 %} hidden{% endif %}"
            ref="quantityLabelCartCount"
          > ({{ cart_quantity }} {{ 'products.product.in_cart' | t }})</span>
        {%- endif -%}
      </h2>
      {% render 'quantity-selector', product: closest.product, block: nil, wrapper_class: wrapper_class %}
    </div>

    {%- if has_quantity_rules -%}
      <div
        class="quantity-rules"
        ref="quantityRules"
      >
        {%- if variant.quantity_rule.increment > 1 -%}
          <span class="quantity-rules__item">
            {{ 'products.product.quantity_increments' | t: increment: variant.quantity_rule.increment }}
          </span>
        {%- endif -%}
        {%- if variant.quantity_rule.min > 1 -%}
          <span class="quantity-rules__item">
            {{ 'products.product.quantity_minimum' | t: minimum: variant.quantity_rule.min }}
          </span>
        {%- endif -%}
        {%- if variant.quantity_rule.max != null -%}
          <span class="quantity-rules__item">
            {{ 'products.product.quantity_maximum' | t: maximum: variant.quantity_rule.max }}
          </span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if product.quantity_price_breaks_configured? and variant.quantity_price_breaks.size > 0 -%}
      {%- liquid
        assign use_currency = settings.currency_code_enabled_product_pages
      -%}
      <volume-pricing
        class="volume-pricing"
        data-section-id="{{ section.id }}"
        ref="volumePricing"
      >
        <span class="volume-pricing__title">{{ 'content.volume_pricing' | t }}</span>
        <div class="volume-pricing__table">
          <div class="volume-pricing__row volume-pricing__row--even">
            <span>{{ variant.quantity_rule.min }}+</span>
            <span>
              <bdi>
                {%- if use_currency -%}
                  {{- variant.price | money_with_currency | strip -}}
                {%- else -%}
                  {{- variant.price | money | strip -}}
                {%- endif -%}</bdi
              >/{{ 'content.each_abbreviation' | t -}}
            </span>
          </div>
          {%- for price_break in variant.quantity_price_breaks limit: 2 -%}
            {%- liquid
              assign row_index = forloop.index
              if row_index == 1
                assign row_class = 'volume-pricing__row volume-pricing__row--odd'
              else
                assign row_class = 'volume-pricing__row volume-pricing__row--even'
              endif
            -%}
            <div class="{{ row_class }}">
              <span>{{ price_break.minimum_quantity }}+</span>
              <span>
                <bdi>
                  {%- if use_currency -%}
                    {{- price_break.price | money_with_currency | strip -}}
                  {%- else -%}
                    {{- price_break.price | money | strip -}}
                  {%- endif -%}</bdi
                >/{{ 'content.each_abbreviation' | t -}}
              </span>
            </div>
          {%- endfor -%}

          {%- if variant.quantity_price_breaks.size > 2 -%}
            <div class="volume-pricing__collapsible-wrapper">
              {%- for price_break in variant.quantity_price_breaks offset: 2 -%}
                {%- liquid
                  assign collapsed_index = forloop.index
                  assign total_index = collapsed_index | plus: 2
                  assign modulo_result = total_index | modulo: 2
                  if modulo_result == 1
                    assign row_class = 'volume-pricing__row volume-pricing__row--odd'
                  else
                    assign row_class = 'volume-pricing__row volume-pricing__row--even'
                  endif
                -%}
                <div class="{{ row_class }}">
                  <span>{{ price_break.minimum_quantity }}+</span>
                  <span>
                    <bdi>
                      {%- if use_currency -%}
                        {{- price_break.price | money_with_currency | strip -}}
                      {%- else -%}
                        {{- price_break.price | money | strip -}}
                      {%- endif -%}</bdi
                    >/{{ 'content.each_abbreviation' | t -}}
                  </span>
                </div>
              {%- endfor -%}
            </div>

            <button
              type="button"
              class="volume-pricing__toggle button-unstyled"
              ref="volumePricingToggle"
              on:click="/toggleExpanded"
            >
              <span class="volume-pricing__toggle-text">
                <span class="volume-pricing__show-more">+ {{ 'actions.show_more' | t }}</span>
                <span class="volume-pricing__show-less">- {{ 'actions.show_less' | t }}</span>
              </span>
            </button>
          {%- endif -%}
        </div>
      </volume-pricing>
    {%- endif -%}
  </div>
</div>
{% render 'buy-buttons-styles' %}
{% stylesheet %}
  .rt-product-quantity {
    inline-size: 100%;
    min-inline-size: 0;
  }

  .rt-product-information .rt-product-quantity .product-form-buttons {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .rt-product-information .rt-product-quantity .product-form-buttons > * {
    flex: none;
    inline-size: 100%;
    min-inline-size: 0;
  }

  .rt-product-quantity :is(.quantity-rules, .quantity-label, .volume-pricing) {
    margin-block: 0;
  }

  .rt-product-purchase__quantity {
    display: flex;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
  }

  .rt-product-quantity .quantity-label {
    flex: 1 1 auto;
    inline-size: auto;
    min-inline-size: 0;
    font-size: 18px;
    font-weight: 600;
    line-height: 24px;
  }

  .rt-product-quantity .quantity-label__cart-count {
    display: inline-block;
    margin-inline-start: 4px;
    font-size: 14px;
    font-weight: 400;
  }

  .rt-product-information .rt-product-quantity .quantity-selector-wrapper {
    inline-size: 176px;
  }

  .rt-product-information .rt-product-quantity .quantity-selector {
    --quantity-selector-width: 176px;
    flex-basis: 176px;
    block-size: 48px;
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-15));
    border-radius: 8px;
    color: var(--color-foreground);
    background: var(--color-background);
  }

  .rt-product-information .rt-product-quantity .quantity-selector :is(.quantity-minus, .quantity-plus) {
    inline-size: 48px;
    block-size: 46px;
    padding: 0;
    border-radius: 0;
    color: inherit;
    background: rgb(var(--color-foreground-rgb) / var(--opacity-5));
  }

  .rt-product-information .rt-product-quantity .quantity-selector .quantity-minus {
    border-start-start-radius: 7px;
    border-end-start-radius: 7px;
  }

  .rt-product-information .rt-product-quantity .quantity-selector .quantity-plus {
    border-start-end-radius: 7px;
    border-end-end-radius: 7px;
    background: rgb(var(--color-foreground-rgb) / var(--opacity-10));
  }

  .rt-product-information .rt-product-quantity .quantity-selector .svg-wrapper {
    inline-size: 32px;
    block-size: 32px;
    background: var(--rt-product-minus) center / contain no-repeat;
  }

  .rt-product-information .rt-product-quantity .quantity-plus .svg-wrapper {
    background-image: var(--rt-product-plus);
  }

  .rt-product-information .rt-product-quantity .quantity-selector svg {
    visibility: hidden;
  }

  .rt-product-information .rt-product-quantity .quantity-selector input[type='number'] {
    inline-size: 78px;
    color: inherit;
    font-size: 18px;
    line-height: 24px;
  }

  @media (max-width: 989px) {
    .rt-product-quantity {
      padding: 20px 24px;
    }

    .rt-product-information .rt-product-quantity .quantity-selector-wrapper,
    .rt-product-information .rt-product-quantity .quantity-selector {
      --quantity-selector-width: 160px;
      inline-size: 160px;
      flex-basis: 160px;
    }

    .rt-product-information .rt-product-quantity .quantity-selector {
      block-size: 44px;
    }

    .rt-product-information .rt-product-quantity .quantity-selector :is(.quantity-minus, .quantity-plus) {
      inline-size: 40px;
      block-size: 42px;
    }

    .rt-product-information .rt-product-quantity .quantity-selector .svg-wrapper {
      inline-size: 24px;
      block-size: 24px;
      background-image: var(--rt-product-minus-mobile);
    }

    .rt-product-information .rt-product-quantity .quantity-plus .svg-wrapper {
      background-image: var(--rt-product-plus-mobile);
    }

    .rt-product-quantity .quantity-label {
      line-height: 22px;
    }

  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:rt_product.quantity",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:content.input"
    },
    {
      "type": "select",
      "id": "input_style",
      "label": "t:settings.style",
      "options": [
        {
          "value": "default",
          "label": "t:options.default"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "default",
      "info": "t:info.edit_input_field_in_theme_settings"
    },
    {
      "type": "color",
      "id": "input_background_color",
      "label": "t:settings.background",
      "default": "{{ settings.color_palette.background }}",
      "visible_if": "{{ block.settings.input_style == \"custom\" }}"
    },
    {
      "type": "color",
      "id": "input_text_color",
      "label": "t:settings.text",
      "default": "{{ settings.color_palette.foreground }}",
      "visible_if": "{{ block.settings.input_style == \"custom\" }}"
    },
    {
      "type": "color",
      "id": "input_border_color",
      "label": "t:settings.borders",
      "default": "{{ settings.color_palette.foreground }}",
      "visible_if": "{{ block.settings.input_style == \"custom\" }}"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "t:settings.border_width",
      "min": 0,
      "max": 4,
      "step": 0.5,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.input_style == \"custom\" }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.input_style == \"custom\" }}"
    }
  ],
  "presets": [
    {
      "name": "t:rt_product.quantity",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
