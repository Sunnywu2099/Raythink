{% doc %}
  One card in a category menu: image, title, and link. A category or card group shows at most four cards.
{% enddoc %}

<a
  class="rt-mega-card"
  href="{{ block.settings.url | default: '#' }}"
  {{ block.shopify_attributes }}
>
  <span class="rt-mega-card__media">
    {% if block.settings.image != blank %}
      {{
        block.settings.image
        | image_url: width: 960
        | image_tag:
          class: 'rt-mega-card__image',
          widths: '240, 360, 480, 720, 960',
          sizes: '(min-width: 990px) 220px, 50vw',
          alt: block.settings.image.alt
          | default: block.settings.title
      }}
    {% endif %}
  </span>
  {% if block.settings.title != blank %}
    <span class="rt-mega-card__title">{{ block.settings.title | escape }}</span>
  {% endif %}
</a>

{% schema %}
{
  "name": "卡片",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "图片"
    },
    {
      "type": "text",
      "id": "title",
      "label": "标题",
      "default": "Card"
    },
    {
      "type": "url",
      "id": "url",
      "label": "链接"
    }
  ],
  "presets": [
    {
      "name": "卡片"
    }
  ]
}
{% endschema %}
