{% doc %}
  A left-side category title. Hovering it shows this category's cards on the right.
{% enddoc %}

<div class="rt-mega__category" data-rt-mega-category>
  <button
    class="rt-mega__tab"
    type="button"
    data-rt-mega-tab
    data-panel-id="{{ block.id }}"
    {{ block.shopify_attributes }}
  >
    {{ block.settings.title | escape }}
  </button>
  <div class="rt-mega__panel" data-rt-mega-panel data-panel-id="{{ block.id }}">
    <div class="rt-mega__cards">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "分类",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "类目标题",
      "default": "Category"
    }
  ],
  "blocks": [
    { "type": "_rt-header-menu-card" }
  ],
  "presets": [
    {
      "name": "分类",
      "blocks": [
        { "type": "_rt-header-menu-card" }
      ]
    }
  ]
}
{% endschema %}
