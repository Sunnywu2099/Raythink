{% doc %}
  Footer menu group. Merchants add up to four menu columns inside this group.

  @example
  {% content_for 'block', type: '_rt-footer-menus', id: 'menus' %}
{% enddoc %}

<div class="rt-footer__menus" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
  {%- if section.settings.contact_email != blank or section.settings.address != blank -%}
    <div class="rt-footer__contact">
      {%- if section.settings.contact_email != blank -%}
        <p class="rt-footer__contact-line">
          <span class="rt-footer__contact-label">{{ 'rt.footer.contact' | t }}:</span>
          <a href="mailto:{{ section.settings.contact_email | escape }}">{{ section.settings.contact_email | escape }}</a>
        </p>
      {%- endif -%}
      {%- if section.settings.address != blank -%}
        <p class="rt-footer__contact-line">
          <span class="rt-footer__contact-label">{{ 'rt.footer.address' | t }}:</span>
          {{ section.settings.address | escape }}
        </p>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "菜单",
  "tag": null,
  "blocks": [
    {
      "type": "_rt-footer-menu"
    }
  ]
}
{% endschema %}
