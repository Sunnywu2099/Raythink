{% doc %}
  A left-side category title. Hovering it shows this category's products on the right.
{% enddoc %}

<div class="rt-mega__category" data-rt-mega-category>
  <button
    class="rt-mega__tab"
    type="button"
    data-rt-mega-tab
    data-panel-id="{{ block.id }}"
    aria-expanded="false"
    {{ block.shopify_attributes }}
  >
    <span class="rt-mega__tab-label">{{ block.settings.title | escape }}</span>
    {% render 'rt-menu-chevron', class: 'rt-mega__tab-icon' %}
  </button>
  <div class="rt-mega__panel" data-rt-mega-panel data-panel-id="{{ block.id }}">
    <div class="rt-mega__cards">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "产品分类",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "分类标题",
      "default": "Category"
    }
  ],
  "blocks": [
    { "type": "_rt-header-menu-product" }
  ],
  "presets": [
    {
      "name": "产品分类",
      "blocks": [
        { "type": "_rt-header-menu-product" }
      ]
    }
  ]
}
{% endschema %}
