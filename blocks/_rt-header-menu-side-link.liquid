{% doc %}
  A text link under the product categories, such as Machine Comparison.
{% enddoc %}

<a
  class="rt-mega__side-link"
  data-rt-mega-link
  href="{{ block.settings.url | default: '#' }}"
  {{ block.shopify_attributes }}
>
  {{ block.settings.title | escape }}
</a>

{% schema %}
{
  "name": "左侧链接",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "名称",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "url",
      "label": "链接"
    }
  ],
  "presets": [
    {
      "name": "左侧链接"
    }
  ]
}
{% endschema %}
