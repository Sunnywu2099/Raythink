{% doc %}
  One product in a product menu. Title, description, image, and button links come from the selected product.
  The badge text and color are set on this block.
{% enddoc %}

{% liquid
  assign menu_product = block.settings.product
  assign badge_text = block.settings.badge_text
  assign badge_color = block.settings.badge_color
%}

{% if menu_product != blank %}
  {% liquid
    assign card_alt = menu_product.featured_image.alt | default: menu_product.title
  %}
  <article class="rt-product-card" {{ block.shopify_attributes }}>
    <div class="rt-product-card__media">
      {% render 'rt-image1picture',
        image: menu_product.featured_image,
        class: 'rt-product-card__image',
        alt: card_alt,
        sizes: '(min-width: 750px) 220px, 80vw',
        loading: 'lazy',
        fetchpriority: 'low'
      %}
    </div>
    <div class="rt-product-card__body">
      {% if badge_text != blank %}
        <p class="rt-product-card__badge" style="color: {{ badge_color }};">{{ badge_text | escape }}</p>
      {% endif %}
      <p class="rt-product-card__title">{{ menu_product.title | escape }}</p>
      {% if menu_product.description != blank %}
        <p class="rt-product-card__description">{{ menu_product.description | strip_html }}</p>
      {% endif %}
      <p class="rt-product-card__actions">
        <a class="rt-product-card__link" href="{{ menu_product.url }}">{{ 'actions.learn_more' | t }}</a>
        <a class="rt-product-card__link" href="{{ menu_product.url }}">{{ 'actions.buy_now' | t }}</a>
      </p>
    </div>
  </article>
{% elsif request.design_mode %}
  <article class="rt-product-card rt-product-card--empty" {{ block.shopify_attributes }}>
    <p class="rt-product-card__title">选择产品</p>
  </article>
{% endif %}

{% schema %}
{
  "name": "产品",
  "tag": null,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "产品"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "标签文案"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "标签颜色",
      "default": "#1B8F3A"
    }
  ],
  "presets": [
    {
      "name": "产品"
    }
  ]
}
{% endschema %}
