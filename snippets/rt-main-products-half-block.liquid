{%  liquid 
  assign image = block.settings.image
  assign title = block.settings.title
  assign title_color = block.settings.title_color
  assign description = block.settings.description
  assign description_color = block.settings.description_color
  assign primary_button_text = block.settings.primary_button_text
  assign primary_link = block.settings.primary_link
  assign secondary_button_text = block.settings.secondary_button_text
  assign secondary_link = block.settings.secondary_link
%}

{% style %}
  #shopify-section-{{ section.id }} .rt-main-products-half-block {
    background-color: #ffffff;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .rt-main-products-half-block .rt-main-products-half-block-content{
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: center;
    margin: 24px 32px 20px;
  }
{% endstyle %}

<div class="rt-main-products-half-block rt-radius-lg">
  <div class="rt-main-products-half-block-content">
    {% render 'rt-heading', variant: 'title', text: title, color: title_color %}
    {% render 'rt-heading', variant: 'description', text: description, color: description_color %}
  </div>
  <div class="rt-main-products-half-block-image">
    {% render 'rt-image2picture', image_mobile: image, image_desktop: image %}
  </div>
</div>