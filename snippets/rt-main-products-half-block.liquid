{%  liquid 
  assign image = block.settings.image
  assign title = block.settings.title
  assign title_color = block.settings.title_color
  assign description = block.settings.description
  assign description_color = block.settings.description_color
  assign primary_button_text = block.settings.primary_button_text
  assign primary_link = block.settings.primary_link
  assign secondary_button_text = block.settings.secondary_button_text
  assign secondary_link = block.settings.secondary_link
%}

<div class="rt-main-products-half-block">
  <div class="rt-main-products-half-block-image">
    <img src="{{ image | image_url: width: 447 }}" alt="{{ title }}" loading="lazy" width="447" height="512">
  </div>
</div>