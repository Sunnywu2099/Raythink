{%- doc -%}
  Renders a <picture> element using separate mobile/desktop Shopify images.
  When only one image is set, that image is used at every viewport.
  Candidate widths never exceed the file's real width.

  @param {image} [image_mobile] - Mobile image object; at least one image is required
  @param {image} [image_desktop] - Desktop image object; at least one image is required
  @param {string} [class] - Additional class for the <img>
  @param {string} [alt] - Alt text override
  @param {string} [sizes] - Sizes attribute (default: 100vw)
  @param {string} [loading] - "eager" (default) or "lazy"
  @param {string} [decoding] - "async" (default) or "sync" or "auto"
  @param {string} [fetchpriority] - "high" (default) | "low" | "auto"

  @example
  {% render 'rt-image2picture', image_mobile: block.settings.image_mobile, image_desktop: block.settings.image_desktop %}
{%- enddoc -%}

{%- liquid
  assign img_base = image_mobile | default: image_desktop
  assign loading_value = loading | default: 'eager'
  assign decoding_value = decoding | default: 'async'
  assign sizes_value = sizes | default: '100vw'
  assign alt_value = alt | default: img_base.alt | default: ''
  assign fetchpriority_value = fetchpriority | default: 'high'
-%}

{% stylesheet %}
  picture {
    width: 100%;
    height: 100%;
    overflow: hidden;

    & > img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }
  }
{% endstylesheet %}

{%- if img_base != blank -%}
  {%- liquid
    assign src_width = img_base.width | at_most: 750
    assign widths = '320,480,750,1100,1500,1920,2560,3840' | split: ','
  -%}

  {%- comment -%}Clamp the last candidate to the real width, then stop to avoid duplicates.{%- endcomment -%}
  {%- capture img_srcset -%}
    {%- for width in widths -%}
      {%- assign candidate_width = width | plus: 0 | at_most: img_base.width -%}
      {{- img_base | image_url: width: candidate_width }} {{ candidate_width }}w
      {%- if candidate_width == img_base.width -%}{%- break -%}{%- endif -%}
      {%- unless forloop.last -%}, {% endunless -%}
    {%- endfor -%}
  {%- endcapture -%}

  <picture>
    {%- if image_desktop != blank and image_mobile != blank and image_desktop != image_mobile -%}
      {%- capture desktop_srcset -%}
        {%- for width in widths -%}
          {%- assign candidate_width = width | plus: 0 | at_most: image_desktop.width -%}
          {{- image_desktop | image_url: width: candidate_width }} {{ candidate_width }}w
          {%- if candidate_width == image_desktop.width -%}{%- break -%}{%- endif -%}
          {%- unless forloop.last -%}, {% endunless -%}
        {%- endfor -%}
      {%- endcapture -%}
      <source
        media="(min-width: 750px)"
        srcset="{{ desktop_srcset | escape }}"
        sizes="{{ sizes_value | escape }}"
        width="{{ image_desktop.width }}"
        height="{{ image_desktop.height }}"
      >
    {%- endif -%}
    <img
      src="{{ img_base | image_url: width: src_width }}"
      srcset="{{ img_srcset | escape }}"
      sizes="{{ sizes_value | escape }}"
      width="{{ img_base.width }}"
      height="{{ img_base.height }}"
      alt="{{ alt_value | escape }}"
      loading="{{ loading_value }}"
      decoding="{{ decoding_value }}"
      fetchpriority="{{ fetchpriority_value }}"
      {% if class != blank %}
        class="{{ class | escape }}"
      {% endif %}
    >
  </picture>
{%- endif -%}
