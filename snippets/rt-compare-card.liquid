{%- doc -%}
  One product card in the comparison section.

  @param {object} block - Section block with product image, name, price, and spec lines
{%- enddoc -%}

{%- liquid
  assign image = block.settings.image
  assign title = block.settings.title
  assign subtitle = block.settings.subtitle
  assign price = block.settings.price
  assign spec_lines = block.settings.specs | newline_to_br | replace: '<br />', '|||' | replace: '<br/>', '|||' | split: '|||'
-%}

<li class="rt-compare-card" {{ block.shopify_attributes }}>
  <div class="rt-compare-media">
    {% render 'rt-image2picture',
      image_mobile: image,
      image_desktop: image,
      alt: title,
      sizes: '(min-width: 750px) 320px, 70vw',
      loading: 'lazy',
      fetchpriority: 'low'
    %}
  </div>
  {%- if title != blank -%}
    <h3 class="rt-compare-name">{{ title | escape }}</h3>
  {%- endif -%}
  {%- if subtitle != blank -%}
    <p class="rt-compare-subtitle">{{ subtitle | escape }}</p>
  {%- endif -%}
  {%- if price != blank -%}
    <p class="rt-compare-price">{{ price | escape }}</p>
  {%- endif -%}
  {%- if block.settings.specs != blank -%}
    <ul class="rt-compare-specs">
      {%- for line in spec_lines -%}
        {%- liquid
          assign clean = line | strip
          assign spec_value = ''
          assign spec_label = ''
          if clean != blank
            assign parts = clean | split: '|'
            assign spec_value = parts | first | strip
            if parts.size > 1
              assign spec_label = parts | last | strip
            endif
          endif
        -%}
        {%- if spec_value != blank -%}
          <li class="rt-compare-spec">
            <p class="rt-compare-spec-value">{{ spec_value | escape }}</p>
            {%- if spec_label != blank -%}
              <p class="rt-compare-spec-label">{{ spec_label | escape }}</p>
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  {%- endif -%}
</li>
