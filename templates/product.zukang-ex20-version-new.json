      "settings": {
        "custom_liquid": "{% comment %}\n  Raythink EX20 - Amazon A+ Detail Page\n  PC: EX20_A_PC_01.jpg - EX20_A_PC_18.jpg\n  MO: EX20_A_MO_01.jpg - EX20_A_MO_18.jpg\n{% endcomment %}\n\n<style>\n  #raythink-ex20-aplus {\n    width: 100%;\n    margin: 0;\n    padding: 0;\n    line-height: 0;\n  }\n\n  #raythink-ex20-aplus .ex20-image {\n    display: block;\n    width: 100%;\n    height: auto;\n    margin: 0;\n    padding: 0;\n    border: 0;\n  }\n\n  #raythink-ex20-aplus picture {\n    display: block;\n    margin: 0;\n    padding: 0;\n  }\n\n  /* Full-width layout */\n  #raythink-ex20-aplus {\n    width: 100vw;\n    max-width: 100vw;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n  }\n\n  @media screen and (max-width: 749px) {\n    #raythink-ex20-aplus {\n      width: 100vw;\n      max-width: 100vw;\n      left: 50%;\n      margin-left: -50vw;\n    }\n  }\n</style>\n\n<div id=\"raythink-ex20-aplus\">\n\n  {% for i in (1..18) %}\n\n    {% if i < 10 %}\n      {% assign image_number = i | prepend: '0' %}\n    {% else %}\n      {% assign image_number = i %}\n    {% endif %}\n\n    {% assign pc_filename = 'EX20_A_PC_' | append: image_number | append: '.jpg' %}\n    {% assign mo_filename = 'EX20_A_MO_' | append: image_number | append: '.jpg' %}\n\n    {% assign pc_url = pc_filename | file_url %}\n    {% assign mo_url = mo_filename | file_url %}\n\n    <picture>\n      <source\n        media=\"(max-width: 749px)\"\n        srcset=\"{{ mo_url }}\"\n      >\n\n      {% if forloop.first %}\n        <img\n          class=\"ex20-image\"\n          src=\"{{ pc_url }}\"\n          alt=\"Raythink EX20 Thermal Imaging Camera - Feature {{ image_number }}\"\n          loading=\"eager\"\n          fetchpriority=\"high\"\n          decoding=\"async\"\n        >\n      {% else %}\n        <img\n          class=\"ex20-image\"\n          src=\"{{ pc_url }}\"\n          alt=\"Raythink EX20 Thermal Imaging Camera - Feature {{ image_number }}\"\n          loading=\"lazy\"\n          decoding=\"async\"\n        >\n      {% endif %}\n    </picture>\n\n  {% endfor %}\n\n</div>",
